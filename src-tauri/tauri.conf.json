{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Undertone Alpha",
  "version": "0.0.8",
  "identifier": "personal.undertone.player",
  "build": { "frontendDist": "../web" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "label": "main",
      "title": "Undertone Alpha",
      "width": 1320,
      "height": 860,
      "minWidth": 360,
      "minHeight": 580,
      "theme": "Dark",
      "backgroundColor": "#111413",
      "dragDropEnabled": false
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' blob: https: asset: http://asset.localhost; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'",
      "assetProtocol": { "enable": true, "scope": ["$APPDATA/audio/**", "$APPDATA/downloads/**"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "Your own little corner of music.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "android": { "minSdkVersion": 26 }
  }
}
